{
  "name": "vektas",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vektas-leads",
      "database_id": "03fa85cb-0544-4aba-8f4b-707ca0295ac0"
    }
  ]
}
